{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "team0-agent-runtime",
  "displayName": "Team0 Living Understanding",
  "version": "0.1.3",
  "description": "Mount a Team0 Living Understanding before every Claude Code turn and return completed turns afterward.",
  "author": {
    "name": "Team0"
  },
  "mcpServers": {
    "team0": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/team0_mcp_proxy.py"
      ],
      "env": {
        "TEAM0_RUNTIME_HOST_ID": "claude-code",
        "PLUGIN_DATA": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
